{
  "name": "mymap-travel-journal",
  "version": "0.3.2",
  "description": "MyMap · 旅行手账 — 完全离线的足迹、游记与本地照片库",
  "main": "./out/main/index.js",
  "author": "Lisalsj",
  "license": "MIT",
  "private": true,
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "dist:win": "npm run build && electron-builder --win nsis portable --x64 --publish never",
    "dist:dir": "npm run build && electron-builder --win --dir --x64",
    "checksums": "node scripts/checksums.cjs",
    "size:report": "node scripts/size-report.cjs"
  },
  "dependencies": {
    "exifr": "^7.1.3",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-to-markdown": "^2.2.0",
    "micromark-extension-gfm": "^3.0.0",
    "sharp": "latest"
  },
  "devDependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/noto-sans-sc": "^5.3.1",
    "@phosphor-icons/react": "^2.1.10",
    "@playwright/test": "latest",
    "@types/d3-geo": "latest",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "latest",
    "d3-geo": "latest",
    "electron": "^45.0.0",
    "electron-builder": "latest",
    "electron-vite": "latest",
    "opencc-js": "^1.4.2",
    "prettier": "^3.9.10",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "latest",
    "remark-gfm": "latest",
    "topojson-client": "^3.1.0",
    "topojson-server": "^3.0.1",
    "topojson-simplify": "^3.0.3",
    "tsx": "latest",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "latest"
  },
  "build": {
    "appId": "com.lisalsj.mymap",
    "productName": "MyMap",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json",
      "!node_modules/**/*",
      {
        "from": "node_modules/sharp",
        "to": "node_modules/sharp",
        "filter": [
          "package.json",
          "LICENSE",
          "dist/**/*.cjs"
        ]
      },
      {
        "from": "node_modules/@img/colour",
        "to": "node_modules/@img/colour",
        "filter": [
          "package.json",
          "LICENSE*",
          "lib/**/*.js",
          "**/*.cjs",
          "**/*.js",
          "!bin/**/*"
        ]
      },
      {
        "from": "node_modules/detect-libc",
        "to": "node_modules/detect-libc",
        "filter": [
          "package.json",
          "LICENSE*",
          "lib/**/*.js",
          "**/*.cjs",
          "**/*.js",
          "!bin/**/*"
        ]
      },
      {
        "from": "node_modules/semver",
        "to": "node_modules/semver",
        "filter": [
          "package.json",
          "LICENSE*",
          "lib/**/*.js",
          "**/*.cjs",
          "**/*.js",
          "!bin/**/*"
        ]
      },
      {
        "from": "node_modules/@img/sharp-win32-x64",
        "to": "node_modules/@img/sharp-win32-x64",
        "filter": [
          "**/*"
        ]
      }
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "data",
        "filter": [
          "cities.json.gz",
          "data-manifest.json",
          "DATA-LICENSES.md",
          "THIRD-PARTY-NOTICES.md",
          "LICENSE-MyMap.txt",
          "icon.png",
          "demo/*.{jpg,jpeg,png,webp}",
          "licenses/**/*"
        ]
      }
    ],
    "asarUnpack": [
      "**/node_modules/sharp/**/*",
      "**/node_modules/@img/**/*"
    ],
    "npmRebuild": false,
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "resources/icon.ico",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "artifactName": "MyMap-${version}-Setup-${arch}.${ext}",
      "createDesktopShortcut": true,
      "differentialPackage": false
    },
    "portable": {
      "artifactName": "MyMap-${version}-Portable-${arch}.${ext}"
    },
    "electronDist": "node_modules/electron/dist",
    "electronLanguages": [
      "en-US",
      "zh-CN",
      "zh-TW"
    ],
    "compression": "maximum",
    "afterPack": "scripts/after-pack.cjs"
  }
}
